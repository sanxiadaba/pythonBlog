# Application
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (at least 32 characters) whenever DEBUG_MODE=False.
SECRET_KEY=
PORT_NUM=5000
DEBUG_MODE=True
SESSION_COOKIE_SECURE=False
MAX_CONTENT_LENGTH_MB=8
ALLOW_REMOTE_IMAGES=False
AUTO_INIT_DB=True
RATELIMIT_STORAGE_URI=memory://
# Number of trusted reverse proxies in front of the app (0 = not behind one).
TRUST_PROXY_HOPS=0

# SQLite is used when DATABASE_URL is omitted.
# MySQL example:
# DATABASE_URL=mysql+pymysql://blog_user:password@127.0.0.1:3306/python_blog?charset=utf8mb4
DATABASE_URL=

# Site
blogLanguage=Chinese
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
USE_GMAIL_OR_QQMAIL=QQMAIL

# Legacy password migration only. Change this before importing an old database.
md5Salt=replace-legacy-salt

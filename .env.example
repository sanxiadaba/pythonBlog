# Application
SECRET_KEY=replace-with-a-random-secret
PORT_NUM=5000
DEBUG_MODE=True
SESSION_COOKIE_SECURE=False
MAX_CONTENT_LENGTH_MB=8
ALLOW_REMOTE_IMAGES=False
AUTO_INIT_DB=True
RATELIMIT_STORAGE_URI=memory://

# SQLite is used when DATABASE_URL is omitted.
# MySQL example:
# DATABASE_URL=mysql+pymysql://blog_user:password@127.0.0.1:3306/python_blog?charset=utf8mb4
DATABASE_URL=

# Site
blogLanguage=Chinese
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
USE_GMAIL_OR_QQMAIL=QQMAIL

# Legacy password migration only. Change this before importing an old database.
md5Salt=replace-legacy-salt
